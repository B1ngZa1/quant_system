# 应用配置
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=your-super-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 数据库配置 - PostgreSQL (唯一支持的主数据库)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=quant_password
POSTGRES_DB=quant_db

# DuckDB 分析引擎 (高速聚合查询与回测)
DUCKDB_PATH=./data/quant_analytics.duckdb
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# DeepSeek AI配置
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Tushare配置
TUSHARE_TOKEN=your-tushare-token

# A 股按交易日全市场横截面根目录（其下为 前复权/YYYY/YYYY-MM-DD.csv；留空则自动用项目根 daily_data/前复权）
# A_SHARE_DAILY_PANEL_DIR=C:\University\quant_system\daily_data\前复权

# 行情列表：本地库过期时优先读上述横截面，再 AKShare（推荐 true）
# QUOTES_PREFER_LOCAL_DAILY_PANEL=true

# 数据源：本地库为主（stock_realtime 新鲜度，分钟）；超时后拉 AKShare
# DATA_QUOTES_DB_MAX_AGE_MINUTES=360

# 每日收盘后同步：增量 K 线入库 + 更新实时表（上海时区）
# ENABLE_DAILY_MARKET_SYNC=true
# DAILY_MARKET_SYNC_HOUR=18
# DAILY_MARKET_SYNC_MINUTE=30
# DAILY_INCREMENTAL_SYMBOL_LIMIT=0
# DAILY_INCREMENTAL_LOOKBACK_DAYS=15

# 日志级别
LOG_LEVEL=INFO
