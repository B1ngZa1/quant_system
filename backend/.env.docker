DEBUG=false
ENVIRONMENT=docker
# Must be overridden in real deployment.
SECRET_KEY=replace_with_secure_secret

# PostgreSQL for docker-compose deployment
DATABASE_TYPE=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=quant_db

# Redis for docker-compose deployment
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Optional third-party keys
DEEPSEEK_API_KEY=
TUSHARE_TOKEN=

LOG_LEVEL=INFO