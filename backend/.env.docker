DEBUG=false
ENVIRONMENT=docker
# Must be overridden in real deployment.
SECRET_KEY=replace_with_secure_secret

# PostgreSQL (主数据库)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=quant_user
# docker-compose requires POSTGRES_PASSWORD from the shell or root .env.
POSTGRES_PASSWORD=quant_password
POSTGRES_DB=quant_db

# DuckDB 分析引擎
DUCKDB_PATH=/app/data/quant_analytics.duckdb
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Optional third-party keys
DEEPSEEK_API_KEY=
TUSHARE_TOKEN=

LOG_LEVEL=INFO
